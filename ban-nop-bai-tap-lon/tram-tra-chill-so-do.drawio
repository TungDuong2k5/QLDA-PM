đóng / mở món" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="445" width="250" height="72" as="geometry"/></mxCell><mxCell id="n12" value="Duyệt / từ chối chi phí phát sinh" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="445" width="250" height="72" as="geometry"/></mxCell><mxCell id="n13" value="Xem bảng điều khiển: doanh thu theo ca &amp;amp; cả ngày" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="545" width="250" height="72" as="geometry"/></mxCell><mxCell id="n14" value="Chọn ngày trên tờ lịch: xem doanh thu từng ca &amp;amp; cả ngày" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="545" width="250" height="72" as="geometry"/></mxCell><mxCell id="n15" value="Đổi mật khẩu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="645" width="250" height="72" as="geometry"/></mxCell><mxCell id="n16" value="Duyệt phiếu kiểm kho cuối ca" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="645" width="250" height="72" as="geometry"/></mxCell><mxCell id="n17" value="Nhân viên&lt;br&gt;bán hàng" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="511" width="50" height="90" as="geometry"/></mxCell><mxCell id="n18" value="Quản lý" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1100" y="386" width="50" height="90" as="geometry"/></mxCell><mxCell id="n38" value="Staff xem được bảng điều khiển (không có chức năng quản trị). Món bị khoá khi nguyên liệu cạn: bán hàng không gọi được cho tới khi mở lại." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9c4;strokeColor=#bda900;align=left;spacingLeft=6;fontSize=11;size=12;" vertex="1" parent="1"><mxGeometry x="260" y="774" width="730" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="UC5Kimkho380991050" name="UC 5 - Kiểm kho"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1290" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Use case – Kiểm kho cuối ca" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#5b3a1e;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1210" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Hết giờ mỗi ca (sáng, chiều, tối) nhân viên đếm kho và gửi phiếu; quản lý nhập thêm hàng và duyệt. Nhân viên không nhập kho." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1210" height="22" as="geometry"/></mxCell><mxCell id="n4" value="Kiểm kho cuối ca" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf7;strokeColor=#9c7a4d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;dashed=0;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="730" height="570" as="geometry"/></mxCell><mxCell id="n16" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n14" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n14" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n14" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n14" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n15" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n15" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n15" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n15" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="«include»" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#2a6fb0;fontColor=#2a6fb0;fontSize=11;" edge="1" parent="1" source="n6" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="«include»" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#2a6fb0;fontColor=#2a6fb0;fontSize=11;" edge="1" parent="1" source="n6" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="«extend»" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=11;" edge="1" parent="1" source="n7" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="«extend»" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=11;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n5" value="Chọn ca vừa hết giờ, đếm kho: nhập số đếm" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="145" width="250" height="72" as="geometry"/></mxCell><mxCell id="n6" value="Gửi phiếu kiểm kho của ca cho quản lý" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="245" width="250" height="72" as="geometry"/></mxCell><mxCell id="n7" value="Sửa &amp;amp; gửi lại phiếu (khi chưa duyệt / bị yêu cầu kiểm lại)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="345" width="250" height="72" as="geometry"/></mxCell><mxCell id="n8" value="Xem hàng quản lý nhập thêm (tự cập nhật trong báo cáo)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="445" width="250" height="72" as="geometry"/></mxCell><mxCell id="n9" value="Nhập thêm hàng ngay trên phiếu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="245" width="250" height="72" as="geometry"/></mxCell><mxCell id="n10" value="Duyệt phiếu kiểm kho" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="345" width="250" height="72" as="geometry"/></mxCell><mxCell id="n11" value="Tồn kho tự cập nhật theo số đếm khi gửi phiếu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="145" width="250" height="72" as="geometry"/></mxCell><mxCell id="n12" value="Yêu cầu kiểm lại (kèm lý do, gỡ điều chỉnh tồn)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="445" width="250" height="72" as="geometry"/></mxCell><mxCell id="n13" value="Nhận thông báo: phiếu chờ duyệt, ca hết giờ chưa kiểm" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="545" width="250" height="72" as="geometry"/></mxCell><mxCell id="n14" value="Nhân viên&lt;br&gt;bán hàng" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="286" width="50" height="90" as="geometry"/></mxCell><mxCell id="n15" value="Quản lý" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1100" y="386" width="50" height="90" as="geometry"/></mxCell><mxCell id="n28" value="Mỗi ca (sáng, chiều, tối) một phiếu. Số đếm là hàng còn lại thật: khi gửi, tồn kho cập nhật bằng số đếm; bánh, đồ ăn vặt khách mua tự ghi ở cột đã bán và tính vào chênh lệch. Hàng quản lý nhập thêm tự hiện trong báo cáo của nhân viên; mục mới thêm vào kho sau khi gửi hiện &quot;Chưa đếm&quot;. Yêu cầu kiểm lại thì gỡ điều chỉnh tồn." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9c4;strokeColor=#bda900;align=left;spacingLeft=6;fontSize=11;size=12;" vertex="1" parent="1"><mxGeometry x="260" y="674" width="730" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="BFDPhnrchcnng1267355593" name="BFD - Phân rã chức năng"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2220" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Sơ đồ phân rã chức năng (BFD) – Hệ thống quản lý Trạm Trà Chill" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#5b3a1e;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="2140" height="34" as="geometry"/></mxCell><mxCel