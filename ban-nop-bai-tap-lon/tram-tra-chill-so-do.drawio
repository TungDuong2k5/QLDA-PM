etry"/></mxCell><mxCell id="n11" value="Check-out (từ lúc hết ca)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="445" width="250" height="72" as="geometry"/></mxCell><mxCell id="n12" value="Nhắc quản lý (qua ca mà chưa check-in)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="545" width="250" height="72" as="geometry"/></mxCell><mxCell id="n13" value="Xử lý nhắc nhở" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="545" width="250" height="72" as="geometry"/></mxCell><mxCell id="n14" value="Thêm / sửa / xoá bản ghi chấm công" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="645" width="250" height="72" as="geometry"/></mxCell><mxCell id="n15" value="Xem bảng chấm công tháng của nhân viên" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="645" width="250" height="72" as="geometry"/></mxCell><mxCell id="n16" value="Nhân viên&lt;br&gt;đi làm" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="386" width="50" height="90" as="geometry"/></mxCell><mxCell id="n17" value="Quản lý" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1100" y="602.6666666666666" width="50" height="90" as="geometry"/></mxCell><mxCell id="n31" value="Ca: sáng 07:30–12:30 (mở check-in sớm 60 phút), chiều 12:30–17:30, tối 17:30–22:30. Chỉ người có lịch hôm đó mới check-in được; chưa tới giờ hiện &quot;Chưa đến giờ check-in&quot;, không có lịch hiện