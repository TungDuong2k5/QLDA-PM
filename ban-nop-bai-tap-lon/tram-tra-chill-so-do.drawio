<mxfile host="app.diagrams.net" agent="Claude" version="24.7.0"><diagram id="UC0Tngqut294271864" name="UC 0 - Tổng quát"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Sơ đồ use case tổng quát – Hệ thống quản lý Trạm Trà Chill" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#5b3a1e;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1620" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Theo ứng dụng hiện tại: 1 tài khoản staff dùng chung tại quầy, nhân viên chấm công bằng mã PIN, không có tính lương / chia sẻ link" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1620" height="22" as="geometry"/></mxCell><mxCell id="n4" value="Hệ thống quản lý Trạm Trà Chill" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf7;strokeColor=#9c7a4d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;dashed=0;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="1000" height="860" as="geometry"/></mxCell><mxCell id="n16" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n13" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n13" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n13" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n13" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n13" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n14" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n15" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n12" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n12" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n12" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n12" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n12" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n12" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n12" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n5" value="1. Tài khoản&lt;br&gt;• Đăng nhập / đăng xuất&lt;br&gt;• Đổi mật khẩu&lt;br&gt;• Phân quyền admin – staff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;align=left;whiteSpace=wrap;fontStyle=0;fontSize=12;spacingTop=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="370" y="150" width="440" height="120" as="geometry"/></mxCell><mxCell id="n6" value="2. Bán hàng &amp;amp; thanh toán&lt;br&gt;• Chọn bàn / mang đi, gọi món &amp;amp; tuỳ chọn&lt;br&gt;• Kiểm tra món hết hàng / bị khoá&lt;br&gt;• Tra cứu khách hàng, tích &amp;amp; đổi điểm&lt;br&gt;• Thanh toán (tiền mặt, chuyển khoản, MoMo, ZaloPay)&lt;br&gt;• Huỷ đơn (chỉ quản lý), xem đơn theo ca" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;align=left;whiteSpace=wrap;fontStyle=0;fontSize=12;spacingTop=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="370" y="300" width="440" height="220" as="geometry"/></mxCell><mxCell id="n7" value="3. Ca bán hàng&lt;br&gt;• Mở ca (cần có người đã check-in)&lt;br&gt;• Ghi chi phí phát sinh&lt;br&gt;• Đóng ca &amp;amp; xem báo cáo ca&lt;br&gt;• Đóng / mở món hết hàng&lt;br&gt;• Kiểm kho cuối ca: đếm &amp;amp; gửi phiếu cho quản lý" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;align=left;whiteSpace=wrap;fontStyle=0;fontSize=12;spacingTop=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="370" y="550" width="440" height="190" as="geometry"/></mxCell><mxCell id="n8" value="4. Chấm công bằng PIN&lt;br&gt;• Check-in (ca đang chạy, có lịch)&lt;br&gt;• Check-out (khi hết ca)&lt;br&gt;• Hoàn tác check-in trong 15 phút&lt;br&gt;• Nhắc quản lý khi chưa check-in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;align=left;whiteSpace=wrap;fontStyle=0;fontSize=12;spacingTop=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="850" y="150" width="440" height="190" as="geometry"/></mxCell><mxCell id="n9" value="5. Quản lý nhân sự (admin)&lt;br&gt;• Hồ sơ nhân viên, đặt mã PIN&lt;br&gt;• Xếp lịch làm việc theo tuần&lt;br&gt;• Bảng chấm công tháng, sửa bản ghi&lt;br&gt;• Xử lý nhắc nhở check-in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;align=left;whiteSpace=wrap;fontStyle=0;fontSize=12;spacingTop=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="850" y="370" width="440" height="210" as="geometry"/></mxCell><mxCell id="n10" value="6. Quản trị cửa hàng (admin)&lt;br&gt;• Thực đơn: danh mục, sản phẩm, topping&lt;br&gt;• Quản lý bàn&lt;br&gt;• Kho nguyên liệu, công thức, nhập / xuất&lt;br&gt;• Duyệt chi phí, yêu cầu đóng / mở món&lt;br&gt;• Duyệt phiếu kiểm kho, nhập thêm hàng theo phiếu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;align=left;whiteSpace=wrap;fontStyle=0;fontSize=12;spacingTop=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="850" y="610" width="440" height="210" as="geometry"/></mxCell><mxCell id="n11" value="7. Bảng điều khiển &amp;amp; báo cáo&lt;br&gt;• Doanh thu theo ca (ca đang bán + ca trước)&lt;br&gt;• Doanh thu cả ngày, bán chạy, tiền két&lt;br&gt;• Xem lại các ngày trước bằng tờ lịch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;align=left;whiteSpace=wrap;fontStyle=0;fontSize=12;spacingTop=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="370" y="770" width="440" height="150" as="geometry"/></mxCell><mxCell id="n12" value="Quản lý&lt;br&gt;(admin)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1430" y="440" width="50" height="90" as="geometry"/></mxCell><mxCell id="n13" value="Nhân viên bán hàng&lt;br&gt;(tài khoản staff)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="380" width="50" height="90" as="geometry"/></mxCell><mxCell id="n14" value="Nhân viên đi làm&lt;br&gt;(nhập mã PIN)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="700" width="50" height="90" as="geometry"/></mxCell><mxCell id="n15" value="Khách hàng&lt;br&gt;(qua nhân viên)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="140" width="50" height="90" as="geometry"/></mxCell><mxCell id="n30" value="Ghi chú: Quản lý dùng được cả các chức năng của staff khi cần xem; trang bán hàng chỉ dành cho staff. Nhân viên đi làm không có tài khoản đăng nhập – họ check-in / check-out trên máy quầy bằng PIN." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9c4;strokeColor=#bda900;align=left;spacingLeft=6;fontSize=11;size=12;" vertex="1" parent="1"><mxGeometry x="330" y="960" width="1000" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="UC1Bnhngca1246809858" name="UC 1 - Bán hàng &amp; ca"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1290" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Use case – Bán hàng &amp;amp; ca bán hàng" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#5b3a1e;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1210" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Tác nhân chính: Nhân viên bán hàng (staff). Quản lý cũng xem được đơn / báo cáo." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1210" height="22" as="geometry"/></mxCell><mxCell id="n4" value="Bán hàng &amp;amp; ca bán hàng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf7;strokeColor=#9c7a4d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;dashed=0;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="730" height="770" as="geometry"/></mxCell><mxCell id="n22" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n19" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n19" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n19" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n19" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n19" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n21" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n19" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n19" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n30" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n19" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n31" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n19" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n32" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n20" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n21" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n21" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n35" value="" style="html=1;endArrow=none;strokeColor=#444444;" edge="1" parent="1" source="n21" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n36" value="«include»" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#2a6fb0;fontColor=#2a6fb0;fontSize=11;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n37" value="«include»" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#2a6fb0;fontColor=#2a6fb0;fontSize=11;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n38" value="«include»" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#2a6fb0;fontColor=#2a6fb0;fontSize=11;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n39" value="«extend»" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=11;" edge="1" parent="1" source="n12" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n40" value="«include»" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#2a6fb0;fontColor=#2a6fb0;fontSize=11;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n5" value="Mở ca bán hàng" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="145" width="250" height="72" as="geometry"/></mxCell><mxCell id="n6" value="Kiểm tra đã có người check-in trong ca" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="145" width="250" height="72" as="geometry"/></mxCell><mxCell id="n7" value="Chọn bàn / mang đi" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="245" width="250" height="72" as="geometry"/></mxCell><mxCell id="n8" value="Gọi món &amp;amp; tuỳ chọn (size, đường, đá, topping)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="245" width="250" height="72" as="geometry"/></mxCell><mxCell id="n9" value="Kiểm tra món hết hàng / bị khoá" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="345" width="250" height="72" as="geometry"/></mxCell><mxCell id="n10" value="Lập đơn &amp;amp; thanh toán (một bước)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="345" width="250" height="72" as="geometry"/></mxCell><mxCell id="n11" value="Tra cứu khách hàng theo SĐT" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="445" width="250" height="72" as="geometry"/></mxCell><mxCell id="n12" value="Tích / đổi điểm" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="445" width="250" height="72" as="geometry"/></mxCell><mxCell id="n13" value="Huỷ đơn (chỉ quản lý)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="545" width="250" height="72" as="geometry"/></mxCell><mxCell id="n14" value="Xem đơn hôm nay / chọn ngày trên tờ lịch (không hiện doanh thu)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="545" width="250" height="72" as="geometry"/></mxCell><mxCell id="n15" value="Ghi chi phí phát sinh" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="645" width="250" height="72" as="geometry"/></mxCell><mxCell id="n16" value="Đóng ca" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="645" width="250" height="72" as="geometry"/></mxCell><mxCell id="n17" value="Xem báo cáo ca" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="745" width="250" height="72" as="geometry"/></mxCell><mxCell id="n18" value="Đóng / mở món hết hàng" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="745" width="250" height="72" as="geometry"/></mxCell><mxCell id="n19" value="Nhân viên&lt;br&gt;bán hàng" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="436" width="50" height="90" as="geometry"/></mxCell><mxCell id="n20" value="Khách hàng" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="586" width="50" height="90" as="geometry"/></mxCell><mxCell id="n21" value="Quản lý" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1100" y="636" width="50" height="90" as="geometry"/></mxCell><mxCell id="n41" value="Quy tắc: không mở được ca nếu chưa ai check-in trong ca đang chạy. Món hết hàng / bị đóng không thể gọi; số lượng gọi không vượt tồn kho (trừ nhóm &quot;đặc biệt&quot;). Đóng ca KHÔNG tự check-out nhân viên." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9c4;strokeColor=#bda900;align=left;spacingLeft=6;fontSize=11;size=12;" vertex="1" parent="1"><mxGeometry x="260" y="874" width="730" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="UC2Chmcng1217457206" name="UC 2 - Chấm công"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1290" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Use case – Chấm công bằng mã PIN" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#5b3a1e;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1210" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Nhân viên đi làm không đăng nhập: thao tác trên máy quầy (tài khoản staff) bằng mã PIN riêng." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1210" height="22" as="geometry"/></mxCell><mxCell id="n4" value="Chấm công" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf7;strokeColor=#9c7a4d;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;dashed=0;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="730" height="670" as="geometry"/></mxCell><mxCell id="n18" value="" style="htm